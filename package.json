{
  "name": "paced",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "engines": {
    "node": "26.10.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/dashboard/tsconfig.json --noEmit",
    "test": "vitest run",
    "simulate": "node --import tsx tools/campaign-simulator/src/cli.ts",
    "format:check": "prettier --check \"packages/**/*.ts\" \"tools/**/*.ts\" package.json tsconfig.json \"tools/campaign-simulator/web/*\" \"apps/**/*.{ts,tsx,css,html,json}\"",
    "demo": "node --import tsx tools/campaign-simulator/src/server.ts",
    "dev": "node --import tsx tools/local-shell/dev.ts",
    "build": "npm run build --workspace @outreach/dashboard"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wrangler": "^4.151.1"
  }
}
