{
  "manifest_version": 3,
  "name": "Paced (read-only)",
  "version": "0.2.0",
  "description": "Tick people on a LinkedIn people-search page to hand the visible fields to your Paced workspace, and record what you see on enrolled people's pages. Reads only pages you open. Sends nothing to LinkedIn.",
  "permissions": ["storage"],
  "host_permissions": ["https://sequence-dev-etj.pages.dev/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/people/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/messaging/*"
      ],
      "js": ["observe.js"],
      "run_at": "document_idle"
    }
  ]
}
